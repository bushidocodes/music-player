{
  "name": "juke",
  "version": "1.0.0",
  "description": "A generated project at Fullstack Academy",
  "type": "module",
  "main": "server/start.ts",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "start": "vite & tsx watch server/start.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p browser/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "seed": "tsx ./bin/seed.ts",
    "db-init": "pg-init juke"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "morgan": "^1.12.1",
    "music-metadata": "^12.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "sequelize": "^6.37.5",
    "serve-favicon": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serve-favicon": "^2.5.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "commander": "^15.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
